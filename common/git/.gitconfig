[core]
	pager = delta
[fetch]
	prune = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers-left-format = ""
	line-numbers-right-format = "│ "
[merge]
	conflictStyle = zdiff3
[pager]
	# diffnav can't render conflict (diff --cc) hunks and crashes, corrupting the terminal; fall back to delta for those
	diff = "sh -c 'if git diff --name-only --diff-filter=U | grep -q .; then delta; else diffnav; fi'"

# Identity and machine-specific settings live outside the repo
[include]
	path = ~/.gitconfig.local
