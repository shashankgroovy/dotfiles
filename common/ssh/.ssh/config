IgnoreUnknown UseKeychain

Host *
  AddKeysToAgent yes
  UseKeychain yes

# Work (default)
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_work
  IdentitiesOnly yes

# Personal: git@github-personal:<user>/<repo>.git
Host github-personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentitiesOnly yes
